{
  "manifest_version": 3,
  "name": "Land Scout — DOL + FB auto-capture",
  "version": "0.3.0",
  "description": "Captures Thai land-sale posts from your logged-in Facebook (feed/groups/marketplace) + DOL parcels — with photos, price, size, coords, seller, and distress signals — and sends them into your land app as scored listings.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://landsmaps.dol.go.th/*",
    "https://dolwebservice.dol.go.th/*",
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.marketplace.com/*",
    "https://www.bam.co.th/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://landsmaps.dol.go.th/*",
        "https://dolwebservice.dol.go.th/*"
      ],
      "js": [
        "capture-dol.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "capture-fb.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bam.co.th/*/npa/property/*",
        "https://www.bam.co.th/*/npa/*"
      ],
      "js": [
        "capture-bam.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Land Scout — captured items"
  }
}